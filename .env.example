# Copie este arquivo para .env e preencha. NUNCA publique o .env.

# ---------- IA (Gemini) ----------
# Chave da API do Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo do Gemini usado na classificação
GEMINI_MODEL=gemini-3.8-flash

# Modelo reserva se o principal estiver sobrecarregado (erro 503). Vazio = a API escolhe sozinha.
GEMINI_MODEL_RESERVA=

# gemini = usa a IA de verdade | simulado = regras locais, sem chave (só para testes)
IA_MODO=gemini

# Tentativas de chamar a IA antes do fallback para revisão humana
IA_MAX_TENTATIVAS=3

# Espera máxima (segundos) entre tentativas quando o Gemini avisa limite de requisições (429)
IA_ESPERA_MAX_SEG=30

# Tempo máximo (segundos) de cada chamada ao Gemini
IA_TIMEOUT_SEG=60

# Temperatura do modelo (ex.: 0.2). Vazio = usa o padrão do próprio modelo.
IA_TEMPERATURA=

# Abaixo desta confiança a mensagem vai para revisão humana
LIMITE_CONFIANCA=0.6

# ---------- WhatsApp (opcional) ----------
# Texto secreto que você inventa. Use o mesmo valor ao cadastrar o webhook no painel da Meta.
# Enquanto estiver vazio, a verificação do webhook é sempre recusada.
WHATSAPP_VERIFY_TOKEN=

# O token de acesso da Meta NÃO fica neste arquivo: ele é salvo dentro do n8n,
# na credencial "WhatsApp API" do node "WhatsApp - Responde ao cliente".
